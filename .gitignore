# Local working notes (docs/ itself is public — self-hosting guide lives there)
notes/
scratch/

# Secrets & env
.env
.env.*
.dev.vars

# Dependencies & build
node_modules/
dist/
.wrangler/

# Agent worktrees (local orchestration scratch, not project content)
.claude/worktrees/

# OS / editor
.DS_Store
wrangler.production.toml
# Any other real deployment's config (this repo is the template; a real
# deployment's ids/vars/domain never belong in the public repo — see the
# workspace CLAUDE.md hard rule 1).
wrangler.*.toml

# Commercial brand typeface — licensed to APOLLO NEXT, never in a public repo.
# Deployed from the local filesystem via [assets]; see assets/fonts/HALVAR-README.txt
# (matched by extension, not by a bare halvar-* glob: this repo is cloned onto
# case-insensitive filesystems, where that glob also swallows HALVAR-README.txt)
assets/fonts/halvar-*.woff2
assets/fonts/halvar-*.woff
assets/fonts/halvar-*.ttf
assets/fonts/halvar-*.otf
